{
  "rootDirectory": "/scamlens",
  "builder": "RAILPACK",
  "dockerfilePath": "Dockerfile",
  "preDeployCommand": ["npm run deploy:prepare"],
  "startCommand": "npm start",
  "healthcheckPath": "/api/health",
